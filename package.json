{
  "name": "freddie-general",
  "version": "0.1.6",
  "description": "Freddie cross-platform paper reader",
  "author": "SYYANI",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bump_version": "node scripts/bump_version.mjs",
    "sync:rebuild": "node scripts/sync-rebuild-pdf.mjs",
    "sync:latex": "node scripts/sync-latex-trans.mjs",
    "sync:babeldoc": "node scripts/sync-babeldoc.mjs",
    "build:babeldoc-wasm": "node scripts/build-babeldoc-wasm.mjs",
    "package": "node scripts/verify-babeldoc-runtime.mjs && npm run build && electron-builder",
    "package:mac": "node scripts/verify-babeldoc-runtime.mjs && npm run build && electron-builder --mac",
    "package:mac:arm64": "node scripts/verify-babeldoc-runtime.mjs && node scripts/install-native-targets.mjs darwin arm64 && npm run build && electron-builder --mac --arm64",
    "package:mac:x64": "node scripts/verify-babeldoc-runtime.mjs && node scripts/install-native-targets.mjs darwin x64 && npm run build && electron-builder --mac --x64",
    "package:win": "node scripts/verify-babeldoc-runtime.mjs && node scripts/install-native-targets.mjs win32 x64 && npm run build && electron-builder --win --x64",
    "package:win:arm64": "node scripts/verify-babeldoc-runtime.mjs && node scripts/install-native-targets.mjs win32 arm64 && npm run build && electron-builder --win --arm64",
    "package:win:x64": "node scripts/verify-babeldoc-runtime.mjs && node scripts/install-native-targets.mjs win32 x64 && npm run build && electron-builder --win --x64",
    "package:linux": "node scripts/verify-babeldoc-runtime.mjs && node scripts/install-native-targets.mjs linux && npm run build && electron-builder --linux",
    "package:linux:arm64": "node scripts/verify-babeldoc-runtime.mjs && node scripts/install-native-targets.mjs linux arm64 && npm run build && electron-builder --linux --arm64",
    "package:linux:x64": "node scripts/verify-babeldoc-runtime.mjs && node scripts/install-native-targets.mjs linux x64 && npm run build && electron-builder --linux --x64",
    "postinstall": "node scripts/patch-dev-electron-name.mjs && node scripts/patch-osx-sign-isbinaryfile.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^1.0.13",
    "@tesseract.js-data/eng": "1.0.0",
    "cheerio": "^1.1.2",
    "fflate": "^0.8.3",
    "jsdom": "^25.0.1",
    "katex": "^0.18.10",
    "koffi": "^3.3.3",
    "lucide-react": "^0.468.0",
    "onnxruntime-node": "1.23.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "katex": "$katex"
  },
  "build": {
    "appId": "com.yiyan.Freddie",
    "productName": "Freddie",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "BabelDocKit/resources/**",
      "!node_modules/@tesseract.js-data/eng/4.0.0/**",
      "!node_modules/tesseract.js-core/*-lstm.{js,wasm,wasm.js}"
    ],
    "extraResources": [
      {
        "from": "BabelDocKit/runtime",
        "to": "babeldoc",
        "filter": [
          "**/*",
          "!UPSTREAM.json",
          "!.DS_Store"
        ]
      }
    ],
    "mac": {
      "identity": "-",
      "icon": "public/icon.png",
      "category": "public.app-category.books",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "signIgnore": [
        "babeldoc/"
      ]
    },
    "win": {
      "icon": "public/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "public/icon.png",
      "category": "Office",
      "maintainer": "SYYANI",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "artifactName": "${productName}.Setup.${version}.${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "node_modules/pdfjs-dist/standard_fonts/**",
      "node_modules/pdfjs-dist/cmaps/**",
      "node_modules/pdfjs-dist/wasm/**",
      "node_modules/@napi-rs/canvas*/**",
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/**",
      "node_modules/bmp-js/**",
      "node_modules/idb-keyval/**",
      "node_modules/is-url/**",
      "node_modules/node-fetch/**",
      "node_modules/whatwg-url/**",
      "node_modules/tr46/**",
      "node_modules/punycode/**",
      "node_modules/webidl-conversions/**",
      "node_modules/regenerator-runtime/**",
      "node_modules/wasm-feature-detect/**",
      "node_modules/zlibjs/**",
      "node_modules/onnxruntime-node/**"
    ]
  }
}
